{
  "name": "@refinio/meaning.core",
  "version": "0.1.0",
  "description": "Meaning Dimension - Semantic similarity via embeddings for cube queries",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:src": "tsc --build tsconfig.src.json",
    "build:test": "tsc --build tsconfig.test.json",
    "watch": "tsc --watch",
    "test": "npm run build && npx mocha test/build/**/*-test.js --exit",
    "clean": "rm -rf src/**/*.js test/**/*.js test/build dist"
  },
  "exports": {
    ".": "./dist/index.js",
    "./recipes/*": "./dist/recipes/*",
    "./types/*": "./dist/types/*",
    "./vector-index/*": "./dist/vector-index/*"
  },
  "author": "cube.core Team",
  "license": "MIT",
  "private": true,
  "dependencies": {},
  "peerDependencies": {
    "@refinio/one.core": "workspace:*"
  },
  "devDependencies": {
    "@refinio/one.core": "workspace:*",
    "@types/chai": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "chai": "catalog:",
    "mocha": "catalog:",
    "source-map-support": "catalog:",
    "typescript": "catalog:"
  },
  "mocha": {
    "require": [
      "source-map-support/register"
    ],
    "enable-source-maps": true
  }
}
